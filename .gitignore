.claude/

# Python
__pycache__/
*.py[cod]
.venv/

# IDE
.vscode/

# System
.DS_Store

# Secrets
.env
.env.*

.wrangler/
debug

# Old local secrets file (no longer read by any script)
scripts/.env

# Google service-account private key for the Search Console API
*service-account*.json
gsc-*.json

# Data (runtime only - source data in ptd_data/data/ is tracked)
data/
!ptd_data/data/
!ptd_data/data/**
*.pkl
*.webp
*.duckdb
*.duckdb.wal
*.duckdb.bak*
*.csv
# ...except the hand-kept source CSVs the build reads, but not the ingest's
# merge-candidate review files written next to them
!ptd_data/data/*.csv
ptd_data/data/*merge_candidates.csv
*.log
*.numbers

growth/

# Model research / backtest scripts (not part of the live app)
analysis/
# Cloudflare Origin CA cert for the Hetzner box
deploy/hetzner/origin.*

# Local symlink to data/athlete_imgs so the dev server serves faces
ptd_data/athlete_imgs
